{
  "name": "terminal",
  "version": "1.0.0",
  "private": true,
  "description": "Bloomberg-style market terminal: news wire, quote board, charts, rates/credit, economic calendar",
  "scripts": {
    "dev": "node scripts/run.mjs dev -p 3000",
    "build": "next build",
    "start": "node scripts/run.mjs start -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.2.5",
    "jsdom": "^26.1.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "typescript": "^5.9.2"
  }
}
